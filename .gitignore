# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- Virtual envs ----
.venv/
venv/
env/

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Type checkers / linters ----
.mypy_cache/
.ruff_cache/

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ---- App runtime (never commit user config / logs) ----
config.json
app.log
*.log

# ---- 第三方下载数据（OpenJLPT 等，CC BY-SA 数据集不入库，转换产物才分发）----
/third_party/

# ---- 用户自装皮肤包（MOD，含第三方版权帧图素材）----
# 仅个人本地使用，绝不入库：素材版权归画师 / IP 方所有，禁止随仓库分发。
# 运行时从该目录加载皮肤包；规范见 docs/skin-pack.md。
/skins/

# ---- 本地临时产物（诊断脚本 / 命令输出 / pytest basetemp），绝不入库 ----
# 根目录下以下划线开头的条目一律视为临时产物。
# 注意写成 /_* 而非 _*，避免误伤子目录里的 __init__.py / __pycache__
/_*
# 诊断遗留文件（非下划线前缀，单独排除）
/shell_ok.txt
/pytest*_out*.txt
# 词库清洗回滚备份（tools/clean_reading_conflicts.py 生成，仅本地保留）
/jlpt_words_extra.json.bak-*
